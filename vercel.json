{
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/observatory-20260702c-favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/record", "destination": "/index.html" },
    { "source": "/import", "destination": "/index.html" },
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/patterns", "destination": "/index.html" }
  ]
}
